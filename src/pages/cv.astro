---
import BaseLayout from "../layouts/BaseLayout.astro";
import TimeLineElement from "../components/cv/TimeLine.astro";
---

<BaseLayout title="Resume" sideBarActiveItemID="cv">
  <div class="mb-5">
    <div class="text-3xl w-full font-bold">Profile</div>
  </div>

  <div class="mb-10 text-justify">
    Aspiring AI engineer with a strong foundation in Electronics and Communication Engineering, currently pursuing an M.Tech in Artificial Intelligence at IIT Patna. [cite_start]Recipient of the prestigious IndiaAI Fellowship [cite: 83] [cite_start]for work on "Bias Detection and Mitigation Frameworks for Recommender System"[cite: 83]. Seeking opportunities to apply my skills in machine learning, deep learning, and AI ethics to create innovative and impactful solutions.
  </div>

  <div class="mb-5">
    <div class="text-3xl w-full font-bold">Education</div>
  </div>

  <div class="time-line-container grid gap-4 mb-10">
    <TimeLineElement
      title="M.Tech in Artificial Intelligence"
      [cite_start]subtitle="2024-2026 at Indian Institute of Technology, Patna [cite: 93]"
    />
    <TimeLineElement
      title="B.Tech in Electronics and Communication Engineering"
      subtitle="2020-2024 at Birla Institute of Technology, Mesra"
    />
     <TimeLineElement
      title="Class XII (CBSE)"
      subtitle="2018-2020 at K.V. No. 2, Bailey Road, Patna (90.2%)"
    />
    <TimeLineElement
      title="Class X (CBSE)"
      subtitle="2017-2018 at K.V. No. 2, Bailey Road, Patna (85.8%)"
    />
  </div>

  <div class="mb-5">
    <div class="text-3xl w-full font-bold">Experience & Internships</div>
  </div>

  <div class="time-line-container mb-10">
    <TimeLineElement
      title="IndiaAI Fellowship Recipient"
      [cite_start]subtitle="Jan 2025 at Indian Institute of Technology Patna [cite: 81, 93]"
    >
      [cite_start]Selected for the prestigious fellowship for the project "Bias Detection and Mitigation Frameworks for Recommender System," under the guidance of Prof. Sriparna Saha[cite: 83].
    </TimeLineElement>
    <TimeLineElement
      title="Summer Intern, Semi-Conductor Laboratory (SCL), MeitY, GoI"
      subtitle="2023 at Mohali"
    >
      Studied the effect on sheet resistance with varying sacrificial oxide thickness and implant species in ion implantation.
    </TimeLineElement>
    <TimeLineElement
      title="Summer Intern, Institute of Nano Science & Technology (INST), DST, GoI"
      subtitle="2022 at Mohali"
    >
      Investigated quantum interference in benzene-based molecules.
    </TimeLineElement>
  </div>

  <div class="mb-5">
    <div class="text-3xl w-full font-bold">Certifications</div>
  </div>

  <ul class="list-disc mx-6 mb-10 grid gap-2">
    <li>
      <a href="#" target="_blank"> Certificate of Distinction in Semiconductor Technology, IISc Bengaluru, 2024</a>
    </li>
    <li>
      <a href="#" target="_blank"> ISWDP Level-1 and Level-2 in Semiconductor Program, IISc Bengaluru, 2024</a>
    </li>
  </ul>

  <div class="mb-5">
    <div class="text-3xl w-full font-bold">Skills</div>
  </div>

  <ul class="list-disc md:columns-5 columns-2 mx-6">
    <li>C</li>
    <li>Python</li>
    <li>MATLAB</li>
    <li>TensorFlow</li>
    <li>PyTorch</li>
    <li>Scikit-learn</li>
    <li>Silvaco TCAD</li>
    <li>OriginPro</li>
    <li>Artios</li>
    <li>Gaussian V</li>
    <li>Linux</li>
    <li>Tableau</li>
    <li>Power BI</li>
    <li>Matplotlib</li>
  </ul>
</BaseLayout>
