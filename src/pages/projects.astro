---
import BaseLayout from "../layouts/BaseLayout.astro";
import HorizontalCard from "../components/HorizontalCard.astro";
---

<BaseLayout title="Projects" sideBarActiveItemID="projects">
  <div>
    <div class="text-3xl w-full font-bold mb-5">My Projects</div>
  </div>

  <HorizontalCard
    title="Bias Detection and Mitigation Frameworks for Recommender System"
    img="/post_img.webp"
    desc="My IndiaAI Fellowship project. Designing and implementing frameworks to identify and reduce bias in recommender systems, guided by Prof. Sriparna Saha."
    url="#"
    badge="Fellowship"
  />
  <div class="divider my-0"></div>

  <HorizontalCard
    title="Fairness System in AI"
    img="/post_img.webp"
    desc="Designed algorithms to ensure ethical and unbiased decision-making in AI systems, focusing on reducing bias and improving transparency."
    url="#"
  />
  <div class="divider my-0"></div>

  <HorizontalCard
    title="Fabrication of CdTe based Thin Film Solar Cell"
    img="/post_img.webp"
    desc="Led a project to fabricate and analyze the performance of CdTe-based thin-film solar cells."
    url="#"
  />
  <div class="divider my-0"></div>

  <HorizontalCard
    title="Portfolio Website"
    img="/social_img.webp"
    desc="This personal portfolio website, built with Astro & TailwindCSS (based on the Astrofy template)."
    url="https://github.com/prateek4ai/portfolio"
    badge="Astro"
  />
</BaseLayout>
